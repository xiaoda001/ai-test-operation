# DeepSeek API 密钥
DEEPSEEK_API_KEY=
# DeepSeek API 地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek 模型名称；/chat 必填，smoke 脚本未配置时默认使用 deepseek-flash
DEEPSEEK_MODEL=deepseek-flash
# 后端服务端口
BACKEND_PORT=10110
# 允许访问后端的前端来源，多个地址用逗号分隔
FRONTEND_ORIGINS=http://localhost:10111
# 发给模型的最近对话轮数上限
CHAT_HISTORY_MAX_TURNS=5
