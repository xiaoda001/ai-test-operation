# DeepSeek API 密钥
DEEPSEEK_API_KEY=
# DeepSeek API 地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek 模型名称；/chat 必填，smoke 脚本未配置时默认使用 deepseek-flash
DEEPSEEK_MODEL=deepseek-flash
# 后端服务端口
BACKEND_PORT=10110
# 允许访问后端的前端来源，多个地址用逗号分隔
FRONTEND_ORIGINS=http://localhost:10111
# 保留为原文的最近已完成对话轮数
RECENT_TURNS=4
# Redis 会话地址（需先启动 Redis）
REDIS_URL=redis://127.0.0.1:6379/0
# 会话存储后端：memory 或 redis，默认 memory
SESSION_BACKEND=memory
# 会话滑动过期时间，默认 24 小时
SESSION_TTL_SECONDS=86400
